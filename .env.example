# JobSniper Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=jobsniper
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=jobsniper_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Full database URL (replace with your actual password)
DATABASE_URL=postgresql+asyncpg://jobsniper:your_secure_password_here@db:5432/jobsniper_db

# ============================================
# Redis Cache Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_ENABLED=true

# ============================================
# OpenAI Configuration
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ============================================
# Telegram Bot Configuration
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================
# Just Join IT API Configuration
# ============================================
JJIT_API_URL=https://api.justjoin.it/v2/user-panel/offers/by-cursor
JJIT_CATEGORY_IDS=5
# Category IDs: 1=JavaScript, 2=Java, 3=.NET, 4=Mobile, 5=Python, 6=DevOps, etc.
JJIT_FETCH_INTERVAL=300
# Fetch interval in seconds (default: 300 = 5 minutes)
JJIT_SEARCH_KEYWORDS=Python,Remote
# Comma-separated keywords to search in job titles, cities, and skills
JJIT_LOCATIONS=
# Comma-separated list of preferred cities (e.g., Warsaw,Krakow,London)
# Leave empty to search everywhere

# ============================================
# Matcher Configuration
# ============================================
MATCH_THRESHOLD=80
# Minimum match score (0-100) to trigger notification
CV_PATH=/app/data/cv.pdf
# Path to CV PDF file (inside Docker container)

# ============================================
# Application Configuration
# ============================================
LOG_LEVEL=INFO
# Logging level: DEBUG, INFO, WARNING, ERROR
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2
